// Blizzard: a ground-targeted storm. A non-striking carrier cloud hangs 8 units above the cast
// point and rains falling `shard` Template instances on the emitter clock (SpawnRng, never
// CombatRng); each shard strikes. GroundPoint acquisition falls back to SelfPoint (storm over the
// caster's own head) when no ground point was aimed. Adapted from obelisk-bevy's shipped blizzard.
(
  skill_id: "blizzard",
  phase_durations: ( windup: 0.4, active: 0.1, recovery: 0.3 ),
  collision_windows: [
    ( id: "storm", spawn: Scheduled( phase: Active, offset: 0.0 ), anchor: CastPoint,
      anchor_offset: (0.0, 8.0, 0.0), strikes: false, active_duration: 4.0,
      shape: Sphere( radius: 3.0 ), motion: Static,
      hit_filter: Enemies, hit_mode: OncePerTarget,
      emitter: Some(( rate: 6.0, jitter: 3.0, window: "shard" )) ),
    ( id: "shard", spawn: Template, active_duration: 2.0,
      shape: Sphere( radius: 0.5 ), motion: Linear( speed: 12.0 ), motion_direction: Down,
      hit_filter: Enemies, hit_mode: OncePerTarget ),
  ],
  acquisition: GroundPoint( range: 30.0, fallback: Then(SelfPoint) ),
  vfx_cues: { "on_cast": "on_cast", "emit_shard": "emit_shard", "on_hit": "on_hit" },
  cues: {
    // on_cast fires during Windup at the CASTER (raised to muzzle height) — immediate first-person
    // feedback that the storm is going off. The old blizzard had no on_cast cue, so the caster saw
    // nothing at cast time (the storm is 8u overhead, out of a horizontal view).
    "on_cast": ( effect: Some("blizzard_frost"), attach: World, anim: None,
      params: [ ( param: "scale", source: Charge ) ] ),
    // emit_shard fires per shard-spawn at the storm. `blizzard_frost` (bright additive-HDR cyan)
    // replaces the built-in `Snow` preset, whose tiny/dim/+5u-offset particles never read in-game.
    "emit_shard": ( effect: Some("blizzard_frost"), attach: World, anim: None, params: [] ),
    // on_hit fires at each shard's ground/target impact — the spot the caster is LOOKING at (you
    // aim GroundPoint by looking down), so this is the most reliably in-view blizzard feedback.
    "on_hit": ( effect: Some("blizzard_frost"), attach: World, anim: None, params: [] ),
  },
)
