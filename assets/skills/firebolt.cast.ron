// Firebolt (v2): a ballistic fire bolt. Causality is rules-side now (config/skills/firebolt.toml):
// however the bolt ends (enemy hit / world impact / fuse) it triggers firebolt_explosion's OWN
// timeline at that position. No inline chained blast window (that was v1). The explosion's VISUAL
// lives on firebolt_explosion (on_window_blast), so this skill only authors cast/trail/hit cues.
// `on_end_bolt` fires (in vfx_cues) but has NO `cues` binding: it is the TEARDOWN trigger for the
// Follow trail proxy (client despawns it when the bolt's end cue arrives) — without it the trail
// flies past an early impact until its fixed lifetime. No end visual here (the boom is the explosion).
(
  skill_id: "firebolt",
  phase_durations: ( windup: 0.3, active: 0.1, recovery: 0.2 ),
  collision_windows: [
    ( id: "bolt", spawn: Scheduled( phase: Active, offset: 0.0 ), active_duration: 2.0,
      shape: Sphere( radius: 0.5 ), motion: Ballistic( speed: 20.0, gravity: 9.8 ),
      hit_filter: Enemies, hit_mode: FirstOnly ),
  ],
  acquisition: Aim,
  chargeable: true,
  max_hold: 1.5,
  // Charge-hold presentation (charge_cues, host-driven — both peers see it via the input
  // stream): embers gather on the casting hand from the first held tick; at 60% charge the
  // gather IGNITES (the tier crossing drains the old loop, starts the storm). "scale" streams
  // the LIVE charge fraction into the running loop so the glow swells within a tier too.
  charge_cues: [
    ( threshold: 0.0, cue: ( effect: Some("charge_sparks"),
        attach: Bone( socket: "R_wrist_joint", offset: (0.0, 0.05, 0.0) ),
        anim: Some("casting_idle"),
        params: [ ( param: "scale", source: Charge ) ] ) ),
    ( threshold: 0.6, cue: ( effect: Some("charge_storm"),
        attach: Bone( socket: "R_wrist_joint", offset: (0.0, 0.05, 0.0) ),
        anim: Some("casting_idle"),
        params: [ ( param: "scale", source: Charge ) ] ) ),
  ],
  vfx_cues: {
    "on_cast": "on_cast",
    "on_window_bolt": "on_window_bolt",
    "on_hit": "on_hit",
    "on_end_bolt": "on_end_bolt",
  },
  cues: {
    // The muzzle flash rides the SAME hand the charge gathered on (and the projectile now
    // launches from — net::CAST_HAND_OFFSET).
    "on_cast": ( effect: Some("Fire"), attach: Bone( socket: "R_wrist_joint", offset: (0.0, 0.05, 0.0) ), anim: None,
      params: [ ( param: "scale", source: Charge ) ] ),
    "on_window_bolt": ( effect: Some("firebolt_trail"), attach: Follow, anim: None, params: [] ),
    "on_hit": ( effect: Some("Sparks"), attach: World, anim: None, params: [] ),
  },
)
