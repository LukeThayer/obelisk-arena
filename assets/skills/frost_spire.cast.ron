// Frost Spire (potted-spring port): erupt a spire out of a frost patch the glacier painted.
// GroundPoint's on_surface gate (obelisk surfaces core) requires the aimed point to land on a
// frost patch, SNAPS the cast point to the patch center, and CONSUMES the patch at cast-accept —
// all authored data now; cast_pipeline::validate_arena_aim no longer has a frost arm. Fizzle is
// the paid rejection for a point off any frost patch. The damage window is a capsule the size of
// the rising spire (anchor_offset lifts its center to half-height); the PHYSICAL spire is a
// server skill object spawned on the "on_window_spike" cue (server/verbs.rs), which erupts at
// the cue position (already the snapped patch center) and consumes nothing.
(
  skill_id: "frost_spire",
  phase_durations: ( windup: 0.25, active: 0.1, recovery: 0.25 ),
  collision_windows: [
    ( id: "spike", spawn: Scheduled( phase: Active, offset: 0.0 ), anchor: CastPoint,
      anchor_offset: (0.0, 0.8, 0.0), active_duration: 0.25,
      shape: Capsule( radius: 0.45, height: 1.6 ), motion: Static,
      hit_filter: Enemies, hit_mode: OncePerTarget ),
  ],
  acquisition: GroundPoint( range: 60.0, fallback: Fizzle,
    on_surface: Some(( surface: "frost", snap: true, consume: true )) ),
  chargeable: true,
  max_hold: 1.5,
  // Charge-hold presentation: frost gathers on the casting hand while aiming the tile.
  charge_cues: [
    ( threshold: 0.0, cue: ( effect: Some("blizzard_frost"),
        attach: Bone( socket: "R_wrist_joint", offset: (0.0, 0.05, 0.0) ),
        anim: Some("casting_idle"),
        params: [ ( param: "scale", source: Charge ) ] ) ),
  ],
  vfx_cues: { "on_cast": "on_cast", "on_window_spike": "on_window_spike" },
  cues: {
    "on_cast": ( effect: Some("blizzard_frost"), attach: Bone( socket: "R_wrist_joint", offset: (0.0, 0.05, 0.0) ), anim: None, params: [],
      duration: Some(0.25) ),
    "on_window_spike": ( effect: Some("blizzard_frost"), attach: World, anim: None, params: [],
      duration: Some(0.4) ),
  },
)
