// Glacier Roll (potted-spring port, stage 2 of 3, TRIGGERED-ONLY): the grounded roll.
// Executes at rolling_glacier's ground-impact point (CastPoint = the world-hit the landing detector
// fired). THE AUTHORITY FLIP (glacier-physics-ball): the same avian `RigidBody::Dynamic` ball that
// flew here now ROLLS under its own physics; this "roll" window is `Static` and PINNED to that ball
// (server/glacier_ball.rs writes the ball's avian Position into this hitbox's Transform each tick,
// BEFORE obelisk's overlap + paint sets), so the frost Trail this window PAINTS (paints: Trail —
// surfaces core) and its contact damage follow the ball's REAL rolling path (bank shots included).
// No self-propulsion (`motion: Static`, not Linear), no wall detector: the roll ends ONLY at the
// 6.5s fuse (on_expire) -> glacier_burst (rules) — wisp parity (its 6.5s fuse is the only end).
(
  skill_id: "glacier_roll",
  phase_durations: ( windup: 0.0, active: 0.05, recovery: 0.0 ),
  collision_windows: [
    ( id: "roll", spawn: Scheduled( phase: Active, offset: 0.0 ), anchor: CastPoint,
      anchor_offset: (0.0, 0.35, 0.0), active_duration: 6.5,
      shape: Sphere( radius: 0.32 ), motion: Static,
      hit_filter: Enemies, hit_mode: OncePerTarget,
      paints: Some(( surface: "frost", radius: 0.45, mode: Trail( step: 0.8 ) )) ),
  ],
  acquisition: SelfPoint,
  // on_window_roll / on_end_roll are the ROLLING-BOULDER verb channel (server/verbs.rs): the roll
  // window's open cue SPAWNS the kinematic ice ball (lockstep with the roll), its end cue DESPAWNS
  // it where the roll stops (wall / fuse). Listing them in vfx_cues is what makes obelisk EMIT
  // them; they are deliberately NOT bound in `cues:` below — the ball itself is the visual, so the
  // client leaves them cosmetically unbound (a one-time `cue_unbound` warn each, by design).
  vfx_cues: { "on_hit": "on_hit", "on_window_roll": "on_window_roll", "on_end_roll": "on_end_roll" },
  cues: {
    "on_hit": ( effect: Some("blizzard_frost"), attach: World, anim: None, params: [],
      duration: Some(0.3) ),
  },
)
