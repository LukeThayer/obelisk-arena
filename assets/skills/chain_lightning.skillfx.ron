(
    skill_id: "chain_lightning",
    lanes: {
        // Muzzle crackle + cast anim at windup start.
        "chain_lightning_cast": ( lane_id: "cl_muzzle", kind: OnCast,
            particle: Some(( count: 10, lifetime: 0.3, color: (0.5, 0.7, 1.0), speed: 3.0,
                effect: Some("Sparks") )),
            anim: Some(( state: "cast_release" )) ),
        // The lightning arcs: two-anchor beam lanes on the window-open cues (each beam cue
        // carries caster→victim / victim→victim anchors) — Sparks bursts sampled along the arc.
        "chain_lightning_window_arc": ( lane_id: "cl_arc", kind: OnWindow,
            beam: Some(( effect: Some("Sparks"), color: (0.5, 0.7, 1.0), segments: 10, lifetime: 0.25 )) ),
        "chain_lightning_window_hop": ( lane_id: "cl_hop", kind: OnWindow,
            beam: Some(( effect: Some("Sparks"), color: (0.6, 0.8, 1.0), segments: 8, lifetime: 0.25 )) ),
        // Strike bursts at each victim (the beam's end position IS the victim).
        "chain_lightning_end_arc": ( lane_id: "cl_strike", kind: OnEnd,
            particle: Some(( count: 16, lifetime: 0.4, color: (0.7, 0.85, 1.0), speed: 4.0,
                effect: Some("Sparks") )) ),
        "chain_lightning_end_hop": ( lane_id: "cl_strike_hop", kind: OnEnd,
            particle: Some(( count: 12, lifetime: 0.35, color: (0.7, 0.85, 1.0), speed: 4.0,
                effect: Some("Sparks") )) ),
        // Small victim-anchored flash on each confirm.
        "chain_lightning_impact": ( lane_id: "cl_impact", kind: OnHit,
            particle: Some(( count: 6, lifetime: 0.25, color: (0.8, 0.9, 1.0), speed: 2.5 )) ),
    },
)
