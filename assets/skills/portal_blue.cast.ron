// Blue Portal (wisp portal-weapon port): mark a surface point; the server spawns/replaces the
// caster's BLUE portal disc there (server/verbs.rs, cue "on_window_portal_mark" — it
// re-raycasts eye->mark for the surface NORMAL, which the flat GroundPoint aim doesn't carry).
// The mark window is strikes:false — pure cue emission, no hits, no damage. GroundPoint 15
// falls back to SelfPoint: an into-the-sky aim drops the portal at the caster's feet rather
// than fizzling (wisp lets you place at your own position).
(
  skill_id: "portal_blue",
  phase_durations: ( windup: 0.15, active: 0.05, recovery: 0.15 ),
  collision_windows: [
    ( id: "portal_mark", spawn: Scheduled( phase: Active, offset: 0.0 ), anchor: CastPoint,
      strikes: false, active_duration: 0.05, shape: Sphere( radius: 0.1 ), motion: Static,
      hit_filter: Enemies, hit_mode: OncePerTarget ),
  ],
  acquisition: GroundPoint( range: 15.0, fallback: Then(SelfPoint) ),
  vfx_cues: { "on_window_portal_mark": "on_window_portal_mark" },
  cues: {
    "on_window_portal_mark": ( effect: Some("Portal"), attach: World, anim: None, params: [],
      duration: Some(0.5) ),
  },
)
